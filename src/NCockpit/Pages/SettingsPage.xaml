<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCockpit.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="#f5f5f5">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="#1a2744" 
              Padding="24,16">
            <VerticalStackLayout Spacing="8">
                <Label Text="Settings" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" />
                <Label Text="Configure your application preferences" 
                       FontSize="14" 
                       TextColor="#b0b8c8" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                
                <!-- General Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="General" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1a2744" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="#e0e0e0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Application settings and preferences will appear here" 
                                   FontSize="12" 
                                   TextColor="#999999" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

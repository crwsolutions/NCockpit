<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NCockpit.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="{StaticResource Navy}" 
              Padding="24,16">
            <VerticalStackLayout Spacing="8">
                <Label Text="Settings" 
                       Style="{StaticResource PageHeader}" />
                <Label Text="Configure your application preferences" 
                       Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                
                <!-- General Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="General" 
                           Style="{StaticResource SectionTitle}" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Application settings and preferences will appear here" 
                                   Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

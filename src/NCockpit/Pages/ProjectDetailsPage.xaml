<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NCockpit.Models"
             xmlns:viewmodels="clr-namespace:NCockpit.ViewModels"
             xmlns:cv="clr-namespace:NCockpit.Controls"
             xmlns:services="clr-namespace:NCockpit.Services"
             x:Class="NCockpit.Pages.ProjectDetailsPage"
             x:DataType="viewmodels:ProjectDetailsPageViewModel"
             Title="Project Details"
             BackgroundColor="#f5f8fc">

    <Grid x:Name="Page" RowDefinitions="Auto,Auto,Auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" Background="#f5f8fc"
              
              Padding="24,16"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <!-- Back button -->
            <cv:GlyphButton Grid.Column="0"
                            Glyph="&#xf060;"
                            GlyphColor="#3b82f6"
                            IconSize="18"
                            ButtonPadding="8"
                            VerticalOptions="Center"
                            Command="{Binding BackCommand}" />

            <!-- Title + status -->
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0"
                            Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                            FontFamily="FontAwesomeSolid"
                            FontSize="18"
                            TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                            Background="Transparent"
                            Padding="0"
                            VerticalOptions="Center"
                            HorizontalOptions="Start"
                            Command="{Binding ToggleFavoriteCommand}"
                            SemanticProperties.Description="Toggle favorite" />
                    <Label Grid.Column="1" Text="{Binding CurrentProject.Name, FallbackValue='Project Details'}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1a2744" />
                </Grid>
                <HorizontalStackLayout Spacing="8">
                    <Ellipse WidthRequest="8" HeightRequest="8" Fill="#22c55e" />
                    <Label Text="Active"
                           FontSize="12"
                           TextColor="#6b7280" />
                    <Label Text="{Binding CurrentProject.FolderPath}"
                           FontSize="12"
                           TextColor="#6b7280"
                           Margin="8,0,0,0" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Last updated + Refresh button -->
            <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                <Label Text="{Binding LastRefreshedDisplay}"
                       FontSize="12"
                       TextColor="#9ca3af"
                       VerticalOptions="Center" />
                <cv:GlyphButton Glyph="&#xf2f1;"
                                GlyphColor="#3b82f6"
                                IconSize="18"
                                ButtonPadding="8"
                                VerticalOptions="Center"
                                Command="{Binding RefreshProjectCommand}"
                                CanExecute="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Action row -->
        <HorizontalStackLayout Spacing="24" Grid.Row="1" Padding="24,12">
            <cv:QuickAction Text="Open folder"
                            Glyph="&#xf07b;"
                            GlyphColor="#FFD45D"
                            Command="{Binding OpenLocationCommand}"
                            CommandParameter="{Binding CurrentProject.FolderPath}" />
            <!-- Solution type: open the primary solution in Visual Studio -->
            <cv:QuickAction Text="Open in Visual Studio"
                            ImageSource="visual_studio_icon.png"
                            Command="{Binding OpenSolutionCommand}"
                            IsVisible="{Binding IsFolderTypeProject, Converter={StaticResource InvertedBoolConverter}}" />
            <!-- Folder type: open the repo folder in VS Code -->
            <cv:QuickAction Text="Open in VS Code"
                            ImageSource="visual_studio_code_icon.png"
                            Command="{Binding OpenFolderCommand}"
                            IsVisible="{Binding IsFolderTypeProject}" />
            <cv:QuickAction Text="GitHub"
                            ImageSource="github.png"
                            Command="{Binding OpenGitHubCommand}"
                            IsVisible="{Binding CurrentProject.GitRepoUrl, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
        </HorizontalStackLayout>

        <!-- Tabs -->
        <Border Grid.Row="2"
                
                Padding="24,0"
                Stroke="#e5e7eb"
                StrokeThickness="0">
            <HorizontalStackLayout Spacing="24">
                <StackLayout VerticalOptions="Fill">
                    <Label Text="Overview"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#3b82f6"
                           Padding="8,12" />
                    <BoxView HeightRequest="2" BackgroundColor="#3b82f6" />
                </StackLayout>
                <Label Text="Source"
                       FontSize="14"
                       TextColor="#6b7280"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Projects"
                       FontSize="14"
                       TextColor="#6b7280"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Mobile"
                       FontSize="14"
                       TextColor="#6b7280"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Files"
                       FontSize="14"
                       TextColor="#6b7280"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Links"
                       FontSize="14"
                       TextColor="#6b7280"
                       Padding="8,14"
                       VerticalOptions="Fill" />
            </HorizontalStackLayout>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="24" Spacing="20" 
                                 IsVisible="{Binding HasProject}">

                <!-- Error / loading -->
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="#d32f2f" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="#0d7377"
                                   IsVisible="{Binding IsLoading}" />

                <!-- Three-column layout: main + sidebar -->
                <Grid ColumnDefinitions="*,*,300" ColumnSpacing="20">
                    <!-- Left column: Project info + Files -->
                    <VerticalStackLayout Grid.Column="0" Spacing="20">
                        <cv:SectionCard Title="Project info">
                            <!-- The Project info panel is pointed at the favorite
                                 project: its name, project file, folder and last
                                 modified time, plus a simple type label derived
                                 from the project file. -->
                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding HasInfoProject}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="Type" FontSize="12" TextColor="#6b7280" WidthRequest="100" />
                                    <Label Grid.Column="1" Text="{Binding InfoProjectType}" FontSize="12" TextColor="#1a2744" FontAttributes="Bold" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="Project" FontSize="12" TextColor="#6b7280" WidthRequest="100" />
                                    <Label Grid.Column="1" Text="{Binding InfoProjectName}" FontSize="12" TextColor="#1a2744" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="Project file" FontSize="12" TextColor="#6b7280" WidthRequest="100" />
                                    <Label Grid.Column="1" Text="{Binding InfoProjectPath}" FontSize="12" TextColor="#3b82f6" LineBreakMode="TailTruncation" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="Folder" FontSize="12" TextColor="#6b7280" WidthRequest="100" />
                                    <Label Grid.Column="1" Text="{Binding InfoProjectFolder}" FontSize="12" TextColor="#1a2744" LineBreakMode="TailTruncation" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="Last modified" FontSize="12" TextColor="#6b7280" WidthRequest="100" />
                                    <Label Grid.Column="1" Text="{Binding InfoProjectLastModifiedDisplay}" FontSize="12" TextColor="#1a2744" />
                                </Grid>
                            </VerticalStackLayout>

                            <Label Text="No favorite project yet."
                                   FontSize="12"
                                   TextColor="#9ca3af"
                                   IsVisible="{Binding HasInfoProject, Converter={StaticResource InvertedBoolConverter}}" />
                        </cv:SectionCard>

                        <cv:SectionCard Title="Files">
                            <VerticalStackLayout Spacing="8">
                                <!-- File list -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <cv:FileAction Text="{Binding .}"
                                                           Path="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="No root files discovered."
                                       FontSize="12"
                                       TextColor="#9ca3af"
                                       Padding="0,8"
                                       IsVisible="{Binding HasFiles, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </cv:SectionCard>
                    </VerticalStackLayout>

                    <!-- Middle column: Locations + Solution -->
                    <VerticalStackLayout Grid.Column="1" Spacing="20">
                        <cv:SectionCard Title="Project locations">
                            <VerticalStackLayout Spacing="16">
                                <!-- Primary location -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Primary location"
                                           FontSize="12"
                                           TextColor="#6b7280" />
                                    <cv:FolderAction Text="{Binding CurrentProject.FolderPath}"
                                                     Path="{Binding CurrentProject.FolderPath}" />
                                </VerticalStackLayout>

                                <!-- Secondary locations -->
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="Secondary locations"
                                               FontSize="12"
                                               TextColor="#6b7280" />
                                        <Button Grid.Column="1"
                                                Text="+ Link"
                                                Padding="8,4"
                                                CornerRadius="4"
                                                BackgroundColor="#3b82f6"
                                                TextColor="White"
                                                FontSize="11"
                                                Command="{Binding LinkSecondaryFolderCommand}" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LinkedFolders}"
                                                         Spacing="8"
                                                         IsVisible="{Binding HasLinkedFolders}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:SupportingFolder">
                                                <Border Padding="10"
                                                        BackgroundColor="#f5f8fc"
                                                        Stroke="#e5e7eb"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                            <Label Text="{Binding FolderName}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1a2744" />
                                                            <Label Text="{Binding Path}"
                                                                   FontSize="11"
                                                                   TextColor="#6b7280"
                                                                   LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>

                                                        <Button Grid.Column="1"
                                                                Text="Open"
                                                                Padding="6,4"
                                                                CornerRadius="4"
                                                                BackgroundColor="#6b7280"
                                                                TextColor="White"
                                                                FontSize="11"
                                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenLocationCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding Path}" />

                                                        <Button Grid.Column="2"
                                                                Text="Remove"
                                                                Padding="6,4"
                                                                CornerRadius="4"
                                                                BackgroundColor="#d32f2f"
                                                                TextColor="White"
                                                                FontSize="11"
                                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.UnlinkSecondaryFolderCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding .}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label Text="No secondary folders linked yet."
                                           FontSize="12"
                                           TextColor="#9ca3af"
                                           IsVisible="{Binding HasLinkedFolders, Converter={StaticResource InvertedBoolConverter}}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </cv:SectionCard>

                        <!-- Solutions & Projects: every solution as an expandable
                             parent with its referenced projects as children, and
                             the orphan project files under an "Orphans" header.
                             The star on a row sets the favorite solution (parent
                             rows) or favorite project (child rows); exactly one
                             of each always exists. Hidden for folder type
                             projects (no solution files). -->
                        <cv:SectionCard Title="Solutions &amp; Projects"
                                        IsVisible="{Binding ShowSolutionsPanel}">
                            <VerticalStackLayout>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SolutionsTree}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:SolutionTreeItem">
                                            <VerticalStackLayout>
                                                <!-- Solution row: chevron (expand/collapse), VS icon, name, favorite
                                                     star. Tapping the row opens the solution in Visual Studio. -->
                                                <Border Padding="8,6"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenSolutionFileCommand, Mode=OneTime}"
                                                            CommandParameter="{Binding Path}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Button Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronGlyphConverter}}"
                                                                FontFamily="FontAwesomeSolid"
                                                                FontSize="10"
                                                                TextColor="#9ca3af"
                                                                Background="Transparent"
                                                                Padding="4"
                                                                VerticalOptions="Center"
                                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleSolutionExpandCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding .}" />
                                                        <cv:SolutionAction Grid.Column="1" Text="{Binding Name}" Path="{Binding Path}" />

                                                        <Button Grid.Column="2"
                                                                Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                FontFamily="FontAwesomeSolid"
                                                                FontSize="12"
                                                                TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                                Background="Transparent"
                                                                Padding="4"
                                                                VerticalOptions="Center"
                                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleFavoriteSolutionCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding Path}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Child projects (shown when the solution is expanded). -->
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Projects}"
                                                                     IsVisible="{Binding IsExpanded}"
                                                                     Margin="100,0,8,0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SolutionProjectRow">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HeightRequest="28">
                                                                <Image Source="csharp_icon.png"
                                                                    WidthRequest="18"
                                                                    HeightRequest="18"
                                                                    VerticalOptions="Center" />
                                                                <Label Grid.Column="1" 
                                                                    Text="{Binding Name}"
                                                                    FontSize="12"
                                                                    FontAttributes="Bold"
                                                                    TextColor="#3b82f6"
                                                                    VerticalOptions="Center"
                                                                    LineBreakMode="TailTruncation" />
                                                                <Button Grid.Column="2"
                                                                        Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                        FontFamily="FontAwesomeSolid"
                                                                        FontSize="12"
                                                                        TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                                        Background="Transparent"
                                                                        Padding="4" HeightRequest="28"
                                                                        VerticalOptions="Center"
                                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleFavoriteProjectCommand, Mode=OneTime}"
                                                                        CommandParameter="{Binding ProjectPath}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Orphans: project files not referenced by any solution. -->
                                <VerticalStackLayout Spacing="4"
                                                     IsVisible="{Binding HasOrphanProjects}">
                                    <Label Text="Orphans"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#6b7280"
                                           Margin="8,8,0,0" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrphanProjects}"
                                                         Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:SolutionProjectRow">
                                                <Border Padding="8,6"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenLocationCommand, Mode=OneTime}"
                                                            CommandParameter="{Binding FolderPath}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Label Grid.Column="0"
                                                               Text="&#xf071;"
                                                               FontFamily="FontAwesomeSolid"
                                                               FontSize="10"
                                                               TextColor="#6b7280"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               TextColor="#1a2744"
                                                               VerticalOptions="Center"
                                                               LineBreakMode="TailTruncation" />
                                                        <Button Grid.Column="2"
                                                                Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                FontFamily="FontAwesomeSolid"
                                                                FontSize="12"
                                                                TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                                Background="Transparent"
                                                                Padding="4"
                                                                VerticalOptions="Center"
                                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleFavoriteProjectCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding ProjectPath}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="No solutions or projects discovered."
                                       FontSize="12"
                                       TextColor="#9ca3af"
                                       Padding="0,8"
                                       IsVisible="{Binding HasSolutionsTree, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </cv:SectionCard>
                    </VerticalStackLayout>

                    <!-- Right sidebar: Mobile + Related -->
                    <VerticalStackLayout Grid.Column="2" Spacing="20">
                        <cv:SectionCard Title="Mobile">
                            <VerticalStackLayout Spacing="8">
                                <!-- Mobile links grouped by platform -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MobileLinks}"
                                                     Spacing="8"
                                                     IsVisible="{Binding HasMobileLinks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:ReadmeLink">
                                            <cv:LinkAction Text="{Binding Text}"
                                                           Platform="{Binding Platform}"
                                                           Url="{Binding Url}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="No mobile links found in README."
                                       FontSize="12"
                                       TextColor="#9ca3af"
                                       Padding="0,8"
                                       IsVisible="{Binding HasMobileLinks, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </cv:SectionCard>

                        <cv:SectionCard Title="Related projects">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="No related projects yet."
                                       FontSize="12"
                                       TextColor="#9ca3af"
                                       Padding="0,8" />
                            </VerticalStackLayout>
                        </cv:SectionCard>

                        <cv:SectionCard Title="Related links">
                            <VerticalStackLayout Spacing="8">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RelatedLinks}"
                                                     Spacing="8"
                                                     IsVisible="{Binding HasRelatedLinks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:ReadmeLink">
                                            <cv:LinkAction Text="{Binding Text}"
                                                           Platform="Other"
                                                           Url="{Binding Url}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="No related links found in README."
                                       FontSize="12"
                                       TextColor="#9ca3af"
                                       Padding="0,8"
                                       IsVisible="{Binding HasRelatedLinks, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </cv:SectionCard>
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- No project selected -->
        <VerticalStackLayout Grid.Row="3"
                             Spacing="8"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding HasProject, Converter={StaticResource InvertedBoolConverter}}">
            <Label Text="Project not found."
                   FontSize="14"
                   TextColor="#9ca3af"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>

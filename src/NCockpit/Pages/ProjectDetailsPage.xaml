<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NCockpit.Models"
             xmlns:viewmodels="clr-namespace:NCockpit.ViewModels"
             xmlns:cv="clr-namespace:NCockpit.Controls"
             xmlns:services="clr-namespace:NCockpit.Services"
             x:Class="NCockpit.Pages.ProjectDetailsPage"
             x:DataType="viewmodels:ProjectDetailsPageViewModel"
             Title="Project Details"
             BackgroundColor="{StaticResource SurfaceAlt}">

    <Grid x:Name="Page" RowDefinitions="Auto,Auto,auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource SurfaceAlt}"
              
              Padding="24,16"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <!-- Back button -->
            <cv:GlyphButton Grid.Column="0"
                            Glyph="&#xf060;"
                            GlyphColor="{StaticResource AccentBlue}"
                            IconSize="18"
                            ButtonPadding="8"
                            VerticalOptions="Center"
                            Command="{Binding BackCommand}" />

            <!-- Title + status -->
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0"
                            Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                            Style="{StaticResource IconButton}"
                            Padding="0"
                            FontSize="18"
                            TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                            VerticalOptions="Center"
                            HorizontalOptions="Start"
                            Command="{Binding ToggleFavoriteCommand}"
                            SemanticProperties.Description="Toggle favorite" />
                    <Label Grid.Column="1" Text="{Binding CurrentProject.Name, FallbackValue='Project Details'}"
                           FontSize="20" Margin="12,0,0,0"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Navy}" />
                </Grid>
                <HorizontalStackLayout Spacing="8">
                    <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource Success}" />
                    <Label Text="Active"
                           Style="{StaticResource MetaLabel}" />
                    <Label Text="{Binding CurrentProject.FolderPath}"
                           Style="{StaticResource MetaLabel}"
                           Margin="8,0,0,0" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Last updated + Refresh button -->
            <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                <Label Text="{Binding LastRefreshedDisplay}"
                       Style="{StaticResource HintLabel}"
                       VerticalOptions="Center" />
                <cv:GlyphButton Glyph="&#xf2f1;"
                                GlyphColor="{StaticResource AccentBlue}"
                                IconSize="18"
                                ButtonPadding="8"
                                VerticalOptions="Center"
                                Command="{Binding RefreshProjectCommand}"
                                CanExecute="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Action row -->
        <HorizontalStackLayout Spacing="24" Grid.Row="1" Padding="24,12">
            <cv:QuickAction Text="Open folder"
                            Glyph="&#xf07b;"
                            GlyphColor="{StaticResource Warning}"
                            Command="{Binding OpenLocationCommand}"
                            CommandParameter="{Binding CurrentProject.FolderPath}" />
            <!-- Solution type: open the primary solution in Visual Studio -->
            <cv:QuickAction Text="Open in Visual Studio"
                            ImageSource="visual_studio_icon.png"
                            Command="{Binding OpenSolutionCommand}"
                            IsVisible="{Binding IsFolderTypeProject, Converter={StaticResource InvertedBoolConverter}}" />
            <!-- Folder type: open the repo folder in VS Code -->
            <cv:QuickAction Text="Open in VS Code"
                            ImageSource="visual_studio_code_icon.png"
                            Command="{Binding OpenFolderCommand}"
                            IsVisible="{Binding IsFolderTypeProject}" />
            <cv:QuickAction Text="GitHub"
                            ImageSource="github.png"
                            Command="{Binding OpenGitHubCommand}"
                            IsVisible="{Binding CurrentProject.GitRepoUrl, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
        </HorizontalStackLayout>

        <!-- Tabs -->
        <Border Grid.Row="2"
                
                Padding="24,0"
                Stroke="{StaticResource Border}"
                StrokeThickness="0">
            <HorizontalStackLayout Spacing="24">
                <StackLayout VerticalOptions="Fill">
                    <Label Text="Overview"
                           Style="{StaticResource TabActive}"
                           Padding="8,12" />
                    <BoxView HeightRequest="2" BackgroundColor="{StaticResource AccentBlue}" />
                </StackLayout>
                <Label Text="Source"
                       Style="{StaticResource TabInactive}"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Projects"
                       Style="{StaticResource TabInactive}"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Mobile"
                       Style="{StaticResource TabInactive}"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Files"
                       Style="{StaticResource TabInactive}"
                       Padding="8,14"
                       VerticalOptions="Fill" />
                <Label Text="Links"
                       Style="{StaticResource TabInactive}"
                       Padding="8,14"
                       VerticalOptions="Fill" />
            </HorizontalStackLayout>
        </Border>

        <!-- Content: the page itself no longer scrolls; the long panels of the
             layout fill their column's remaining space and scroll in place.
             The grid is named so the DataTemplates below can reach the page's
             binding context (the view-model) through it. -->
        <Grid x:Name="ContentGrid"
              Grid.Row="3"
              ColumnDefinitions="*,*,300"
              ColumnSpacing="20"
              Padding="24,20"
              IsVisible="{Binding HasProject}">

            <!-- Error / loading -->
            <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,*"
                  IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Label Grid.Column="0" Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorLabel}" />
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsLoading}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsLoading}" />
            </Grid>

            <!-- Left column: Project info + Files -->
            <Grid RowDefinitions="Auto,*" RowSpacing="20">
                <cv:SectionCard  Title="Project info">
                    <!-- The Project info panel is pointed at the favorite
                                 project: its name, project file, folder and last
                                 modified time, plus a simple type label derived
                                 from the project file. -->
                    <VerticalStackLayout>
                        <VerticalStackLayout Spacing="12"
                                                     IsVisible="{Binding HasInfoProject}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Type" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectType}" Style="{StaticResource DetailValueBold}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Version" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectVersion}" Style="{StaticResource DetailValue}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Target framework" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectTargetFrameworks}" Style="{StaticResource DetailValue}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="SDK" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectSdk}" Style="{StaticResource DetailValue}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Project" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectName}" Style="{StaticResource DetailValue}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Project file" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectPath}" Style="{StaticResource LinkLabel}" LineBreakMode="TailTruncation" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Folder" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectFolder}" Style="{StaticResource DetailValue}" LineBreakMode="TailTruncation" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" HorizontalOptions="Fill" />

                            <!-- Git state of the repository holding the selected project, read live so the panel says what is actual now. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                          IsVisible="{Binding IsGitRepository}">
                                <Label Grid.Column="0" Text="Git branch" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding GitBranchDisplay}" Style="{StaticResource DetailValueBold}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                          IsVisible="{Binding IsGitRepository}">
                                <Label Grid.Column="0" Text="Git status" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding GitStatusDisplay}" FontSize="12" TextColor="{Binding GitStatusColor}" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" HorizontalOptions="Fill" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Last modified" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding InfoProjectLastModifiedDisplay}" Style="{StaticResource DetailValue}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Last scanned" Style="{StaticResource DetailLabel}" WidthRequest="112" />
                                <Label Grid.Column="1" Text="{Binding LastScannedDisplay}" Style="{StaticResource DetailValue}" />
                            </Grid>
                        </VerticalStackLayout>

                        <Label Text="No favorite project yet."
                                       Style="{StaticResource HintLabel}"
                                       IsVisible="{Binding HasInfoProject, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>

                </cv:SectionCard>

                <!-- Files: the list is unbounded, so it fills the column's
                     remaining space and scrolls in place when it overflows. -->
                <Grid Grid.Row="1">
                    <cv:SectionCard Title="Files">
                        <ScrollView>
                            <VerticalStackLayout Spacing="8" Padding="0,8,0,0">
                                <!-- File list -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <cv:FileAction Text="{Binding .}" Path="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="No root files discovered."
                                       Style="{StaticResource HintLabel}"
                                       Padding="0,8"
                                       IsVisible="{Binding HasFiles, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </cv:SectionCard>
                </Grid>
            </Grid>

            <!-- Middle column: Project locations + Solutions & Projects -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*" RowSpacing="20">
                <cv:SectionCard Grid.Row="0" Title="Project locations">
                    <VerticalStackLayout Spacing="16">
                        <!-- Primary location -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Primary location"
                                           Style="{StaticResource MetaLabel}" />
                            <cv:FolderAction Text="{Binding CurrentProject.FolderPath}"
                                             Path="{Binding CurrentProject.FolderPath}" />
                        </VerticalStackLayout>

                        <!-- Secondary locations -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label VerticalOptions="Center" 
                                       Text="Secondary locations"
                                       Style="{StaticResource MetaLabel}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource PlusButton}"
                                        Command="{Binding LinkSecondaryFolderCommand}" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LinkedFolders}"
                                                 Spacing="8"
                                                 IsVisible="{Binding HasLinkedFolders}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:SupportingFolder">
                                        <Border Padding="10"
                                                        BackgroundColor="{StaticResource SurfaceAlt}"
                                                        Stroke="{StaticResource Border}"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <cv:FolderAction Text="{Binding FolderName}" Path="{Binding Path}" />

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SmallButton}"
                                                        FontFamily="FontAwesomeSolid"
                                                        BackgroundColor="{StaticResource Error}"
                                                        FontSize="14"
                                                        Padding="8,4"
                                                        Text="&#xf2ed;"
                                                        Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.UnlinkSecondaryFolderCommand, Mode=OneTime}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="No secondary folders linked yet."
                                           Style="{StaticResource HintLabel}"
                                           IsVisible="{Binding HasLinkedFolders, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </cv:SectionCard>

                <!-- Solutions & Projects: every solution as an expandable
                     parent with its referenced projects as children, and
                     the orphan project files under an "Orphans" header.
                     The star on a row sets the favorite solution (parent
                     rows) or favorite project (child rows); exactly one
                     of each always exists. Hidden for folder type
                     projects (no solution files). The tree is unbounded,
                     so it fills the column's remaining space and scrolls
                     in place when it overflows. -->
                <Grid Grid.Row="1">
                    <cv:SectionCard Title="Solutions &amp; Projects"
                                IsVisible="{Binding ShowSolutionsPanel}">
                        <ScrollView>
                            <VerticalStackLayout>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SolutionsTree}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:SolutionTreeItem">
                                            <VerticalStackLayout>
                                                <!-- Solution row: chevron (expand/collapse), VS icon, name, favorite
                                                     star. Tapping the row opens the solution in Visual Studio. -->
                                                <Border Padding="8,6"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.OpenSolutionFileCommand, Mode=OneTime}"
                                                            CommandParameter="{Binding Path}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Button Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronGlyphConverter}}"
                                                                Style="{StaticResource TextButton}"
                                                                FontSize="10"
                                                                TextColor="{StaticResource TextMuted}"
                                                                Padding="4"
                                                                VerticalOptions="Center"
                                                                Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.ToggleSolutionExpandCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding .}" />
                                                        <cv:SolutionAction Grid.Column="1" Text="{Binding Name}" Path="{Binding Path}" />

                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource IconButton}"
                                                                Padding="4"
                                                                FontSize="12"
                                                                Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                                VerticalOptions="Center"
                                                                Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.ToggleFavoriteSolutionCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding Path}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Child projects (shown when the solution is expanded). -->
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Projects}"
                                                                     IsVisible="{Binding IsExpanded}"
                                                                     Margin="100,0,8,0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SolutionProjectRow">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HeightRequest="28">
                                                                <Image Source="csharp_icon.png"
                                                                    WidthRequest="18"
                                                                    HeightRequest="18"
                                                                    VerticalOptions="Center" />
                                                                <Label Grid.Column="1" 
                                                                    Style="{StaticResource LinkLabel}"
                                                                    Text="{Binding Name}"
                                                                    VerticalOptions="Center"
                                                                    LineBreakMode="TailTruncation" />
                                                                <Button Grid.Column="2"
                                                                        Style="{StaticResource IconButton}"
                                                                        FontSize="12"
                                                                        Padding="4"
                                                                        Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                        TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                                        HeightRequest="28"
                                                                        VerticalOptions="Center"
                                                                        Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.ToggleFavoriteProjectCommand, Mode=OneTime}"
                                                                        CommandParameter="{Binding ProjectPath}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Orphans: project files not referenced by any solution. -->
                                <VerticalStackLayout Spacing="4"
                                                     IsVisible="{Binding HasOrphanProjects}">
                                    <Label Text="Orphans"
                                           Style="{StaticResource MetaLabel}"
                                           FontAttributes="Bold"
                                           Margin="8,8,0,0" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrphanProjects}"
                                                         Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:SolutionProjectRow">
                                                <Border Padding="8,6"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.OpenLocationCommand, Mode=OneTime}"
                                                            CommandParameter="{Binding FolderPath}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Label Grid.Column="0"
                                                               Text="&#xf071;"
                                                               FontFamily="FontAwesomeSolid"
                                                               FontSize="10"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Style="{StaticResource DetailValue}"
                                                               VerticalOptions="Center"
                                                               LineBreakMode="TailTruncation" />
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource IconButton}"
                                                                FontSize="12"
                                                                Padding="4"
                                                                Text="{Binding IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                                VerticalOptions="Center"
                                                                Command="{Binding Source={x:Reference ContentGrid}, Path=BindingContext.ToggleFavoriteProjectCommand, Mode=OneTime}"
                                                                CommandParameter="{Binding ProjectPath}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="No solutions or projects discovered."
                                       Style="{StaticResource HintLabel}"
                                       Padding="0,8"
                                       IsVisible="{Binding HasSolutionsTree, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </cv:SectionCard>
                </Grid>
            </Grid>

            <!-- Right sidebar: Mobile + Related projects + Related links -->
            <Grid Grid.Column="2"
                  RowDefinitions="2*,Auto,*" RowSpacing="20">
                <!-- Mobile: the links are unbounded, so the panel fills the
                     column's remaining space and scrolls in place when it
                     overflows. -->
                <Grid Grid.Row="0">
                    <cv:SectionCard Title="Mobile">
                        <ScrollView>
                            <VerticalStackLayout Spacing="8" Padding="0,8,0,0">
                                <!-- Mobile links grouped by platform -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MobileLinks}"
                                                     Spacing="8"
                                                     IsVisible="{Binding HasMobileLinks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:ReadmeLink">
                                            <cv:LinkAction Text="{Binding Text}"
                                                           Platform="{Binding Platform}"
                                                           Url="{Binding Url}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="No mobile links found in README."
                           Style="{StaticResource HintLabel}"
                           Padding="0,8"
                           IsVisible="{Binding HasMobileLinks, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </cv:SectionCard>
                </Grid>

                <!-- Related projects: a short list, so it sizes to its content. -->
                <cv:SectionCard Grid.Row="1" Title="Related projects">
                    <VerticalStackLayout Spacing="8" Padding="0,8,0,0">
                        <Label Text="No related projects yet."
                               Style="{StaticResource HintLabel}"
                               Padding="0,8" />
                    </VerticalStackLayout>
                </cv:SectionCard>

                <!-- Related links: the list is unbounded, so the panel fills the
                     column's remaining space and scrolls in place when it
                     overflows. -->
                <Grid Grid.Row="2">
                    <cv:SectionCard Title="Related links">
                        <ScrollView>
                            <VerticalStackLayout Spacing="8" Padding="0,8,0,0">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RelatedLinks}"
                                             Spacing="8"
                                             IsVisible="{Binding HasRelatedLinks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:ReadmeLink">
                                            <cv:LinkAction Text="{Binding Text}"
                                                   Platform="Other"
                                                   Url="{Binding Url}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="No related links found in README."
                               Style="{StaticResource HintLabel}"
                               Padding="0,8"
                               IsVisible="{Binding HasRelatedLinks, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </cv:SectionCard>
                </Grid>
            </Grid>

            <!-- No project selected -->
            <VerticalStackLayout Grid.Row="2"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding HasProject, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Project not found."
                       Style="{StaticResource HintLabel}"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>

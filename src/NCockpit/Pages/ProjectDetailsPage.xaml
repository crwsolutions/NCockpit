<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCockpit.Pages.ProjectDetailsPage"
             Title="Project Details"
             BackgroundColor="#f5f5f5">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="#1a2744" 
              Padding="24,16">
            <VerticalStackLayout Spacing="8">
                <Label Text="Project Details" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" />
                <Label Text="View and manage project information" 
                       FontSize="14" 
                       TextColor="#b0b8c8" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                
                <!-- Project Identity -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Project Identity" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1a2744" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="#e0e0e0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Name:" FontSize="12" TextColor="#666666" WidthRequest="80" />
                                <Label Grid.Column="1" Text="NCockpit" FontSize="12" TextColor="#1a2744" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Type:" FontSize="12" TextColor="#666666" WidthRequest="80" />
                                <Label Grid.Column="1" Text=".NET MAUI Desktop App" FontSize="12" TextColor="#1a2744" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Version:" FontSize="12" TextColor="#666666" WidthRequest="80" />
                                <Label Grid.Column="1" Text="1.0.0" FontSize="12" TextColor="#1a2744" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Framework:" FontSize="12" TextColor="#666666" WidthRequest="80" />
                                <Label Grid.Column="1" Text="net10.0" FontSize="12" TextColor="#1a2744" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Locations -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Locations" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1a2744" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="#e0e0e0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="e:\repos\crwsolutions\NCockpit" 
                                   FontSize="12" 
                                   TextColor="#0d7377" />
                            <Label Text="Primary location" 
                                   FontSize="11" 
                                   TextColor="#999999" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

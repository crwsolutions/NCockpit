<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NCockpit.Models"
             x:Class="NCockpit.Pages.FoldersPage"
             Title="Folders"
             BackgroundColor="{StaticResource Surface}">

    <Grid x:Name="Page" RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="{StaticResource Navy}" 
              Padding="24,16" 
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="Project Folders" 
                       Style="{StaticResource PageHeader}" />
                <Label Text="Configure where to scan for projects" 
                       Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            
            <!-- Add Folder Button -->
            <Button Grid.Column="1"
                    Text="+ Add Folder"
                    Style="{StaticResource PrimaryButton}"
                    Padding="12,8"
                    Command="{Binding AddFolderCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">
                
                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}" 
                       Style="{StaticResource ErrorLabel}" />
                
                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   IsVisible="{Binding IsLoading}" />
                
                <!-- Folders List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Folders}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectFolder">
                            <Border Padding="16" 
                                    BackgroundColor="White"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding Path}" 
                                               Style="{StaticResource DetailValueBold}"
                                               FontSize="13" />
                                        
                                        <Border Grid.Column="1"
                                                Padding="8,4"
                                                BackgroundColor="{StaticResource Accent}"
                                                StrokeShape="RoundRectangle 4"
                                                IsVisible="{Binding IsPrimary}">
                                            <Label Text="Primary"
                                                   Style="{StaticResource BadgeLabel}" />
                                        </Border>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2"
                                                             IsVisible="{Binding IsPrimary}">
                                            <Label Text="Projects" 
                                                   Style="{StaticResource HintLabel}" />
                                            <Label Text="{Binding ProjectCount}" 
                                                   Style="{StaticResource DetailValueBold}"
                                                   FontSize="15" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="0" Spacing="2"
                                                             IsVisible="{Binding IsPrimary, Converter={StaticResource InvertedBoolConverter}}">
                                            <Label Text="Supporting folders" 
                                                   Style="{StaticResource HintLabel}" />
                                            <Label Text="{Binding SupportingFolderCount}" 
                                                   Style="{StaticResource DetailValueBold}"
                                                   FontSize="15" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Last Scan" 
                                                   Style="{StaticResource HintLabel}" />
                                            <Label Text="{Binding LastScanDisplay}" 
                                                   Style="{StaticResource MetaLabel}"
                                                   FontSize="13" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Text="Scan"
                                                Style="{StaticResource SmallButton}"
                                                BackgroundColor="{StaticResource Accent}"
                                                IsVisible="{Binding IsPrimary}"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ScanFolderCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="1"
                                                Text="Open"
                                                Style="{StaticResource SmallButton}"
                                                BackgroundColor="{StaticResource TextSecondary}"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenFolderCommand}"
                                                CommandParameter="{Binding Path}" />

                                        <Button Grid.Column="2"
                                                Text="Delete"
                                                Style="{StaticResource SmallButton}"
                                                BackgroundColor="{StaticResource Error}"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteFolderCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Status Text (e.g. after a scan) -->
        <Label Grid.Row="2"
               Text="{Binding StatusText}"
               Style="{StaticResource MetaLabel}"
               FontSize="11"
               Padding="24,12"
               VerticalOptions="Center"
               IsVisible="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />
    </Grid>

</ContentPage>

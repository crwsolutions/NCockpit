<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NCockpit.Models"
             x:Class="NCockpit.Pages.FoldersPage"
             Title="Folders"
             BackgroundColor="#f5f5f5">

    <Grid x:Name="Page" RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="#1a2744" 
              Padding="24,16" 
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="Project Folders" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" />
                <Label Text="Configure where to scan for projects" 
                       FontSize="14" 
                       TextColor="#b0b8c8" />
            </VerticalStackLayout>
            
            <!-- Add Folder Button -->
            <Button Grid.Column="1"
                    Text="+ Add Folder"
                    Padding="12,8"
                    CornerRadius="6"
                    BackgroundColor="#0d7377"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    Command="{Binding AddFolderCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">
                
                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}" 
                       FontSize="13" 
                       TextColor="#d32f2f" />
                
                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   Color="#0d7377"
                                   IsVisible="{Binding IsLoading}" />
                
                <!-- Folders List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Folders}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectFolder">
                            <Border Padding="16" 
                                    BackgroundColor="White"
                                    Stroke="#e0e0e0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding Path}" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#1a2744" />
                                        
                                        <Border Grid.Column="1"
                                                Padding="8,4"
                                                BackgroundColor="#0d7377"
                                                StrokeShape="RoundRectangle 4"
                                                IsVisible="{Binding IsPrimary}">
                                            <Label Text="Primary"
                                                   FontSize="10"
                                                   TextColor="White"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2"
                                                             IsVisible="{Binding IsPrimary}">
                                            <Label Text="Projects" 
                                                   FontSize="10" 
                                                   TextColor="#999999" />
                                            <Label Text="{Binding ProjectCount}" 
                                                   FontSize="15" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#1a2744" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="0" Spacing="2"
                                                             IsVisible="{Binding IsPrimary, Converter={StaticResource InverseBoolConverter}}">
                                            <Label Text="Supporting folders" 
                                                   FontSize="10" 
                                                   TextColor="#999999" />
                                            <Label Text="{Binding SupportingFolderCount}" 
                                                   FontSize="15" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#1a2744" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Last Scan" 
                                                   FontSize="10" 
                                                   TextColor="#999999" />
                                            <Label Text="{Binding LastScanDisplay}" 
                                                   FontSize="13" 
                                                   TextColor="#666666" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Text="Scan"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                BackgroundColor="#0d7377"
                                                TextColor="White"
                                                FontSize="11"
                                                IsVisible="{Binding IsPrimary}"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ScanFolderCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="1"
                                                Text="Open"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                BackgroundColor="#666666"
                                                TextColor="White"
                                                FontSize="11"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenFolderCommand}"
                                                CommandParameter="{Binding Path}" />

                                        <Button Grid.Column="2"
                                                Text="Delete"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                BackgroundColor="#d32f2f"
                                                TextColor="White"
                                                FontSize="11"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteFolderCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Status Text (e.g. after a scan) -->
        <Label Grid.Row="2"
               Text="{Binding StatusText}"
               FontSize="11"
               TextColor="#666666"
               Padding="24,12"
               VerticalOptions="Center"
               IsVisible="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />
    </Grid>

</ContentPage>

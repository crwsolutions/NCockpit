<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NCockpit.ViewModels"
             x:Class="NCockpit.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel"
             Title="About"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="{StaticResource Navy}" 
              Padding="24,16">
            <VerticalStackLayout Spacing="8">
                <Label Text="About Projects Cockpit"
                       Style="{StaticResource PageHeader}" />
                <Label Text="Your personal project launcher and cockpit"
                       Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                
                <!-- App Info -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Application" 
                           Style="{StaticResource SectionTitle}" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Name:" Style="{StaticResource FieldLabel}" WidthRequest="100" />
                                <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource DetailValueBold}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Version:" Style="{StaticResource FieldLabel}" WidthRequest="100" />
                                <Label Grid.Column="1" Text="{Binding Version}" Style="{StaticResource DetailValue}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Framework:" Style="{StaticResource FieldLabel}" WidthRequest="100" />
                                <Label Grid.Column="1" Text="{Binding Framework}" Style="{StaticResource DetailValue}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Description" 
                           Style="{StaticResource SectionTitle}" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <Label Text="A personal cockpit for quickly finding projects, seeing their important information at a glance, and navigating to associated files, folders, tools and online services." 
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NCockpit.ViewModels"
             x:Class="NCockpit.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel"
             Title="About"
             BackgroundColor="#f5f5f5">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Grid Grid.Row="0" 
              BackgroundColor="#1a2744" 
              Padding="24,16">
            <VerticalStackLayout Spacing="8">
                <Label Text="About Projects Cockpit" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" />
                <Label Text="Your personal project launcher and cockpit" 
                       FontSize="14" 
                       TextColor="#b0b8c8" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                
                <!-- App Info -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Application" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1a2744" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="#e0e0e0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Name:" FontSize="12" TextColor="#666666" WidthRequest="100" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="12" TextColor="#1a2744" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Version:" FontSize="12" TextColor="#666666" WidthRequest="100" />
                                <Label Grid.Column="1" Text="{Binding Version}" FontSize="12" TextColor="#1a2744" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Framework:" FontSize="12" TextColor="#666666" WidthRequest="100" />
                                <Label Grid.Column="1" Text="{Binding Framework}" FontSize="12" TextColor="#1a2744" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Description" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1a2744" />
                    
                    <Border Padding="16" 
                            BackgroundColor="White"
                            Stroke="#e0e0e0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <Label Text="A personal cockpit for quickly finding projects, seeing their important information at a glance, and navigating to associated files, folders, tools and online services." 
                               FontSize="12" 
                               TextColor="#666666" 
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:NCockpit.Controls"
             x:Class="NCockpit.Controls.SectionCard"
             x:Name="This"
             x:DataType="cv:SectionCard">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Padding="16"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Style="{StaticResource SectionTitle}"
                               VerticalOptions="Center"
                               Text="{Binding Title, Source={RelativeSource TemplatedParent}}" />
                        <ContentView Grid.Column="1"
                                     Content="{Binding TitleActions, Source={RelativeSource TemplatedParent}}"
                                     IsVisible="{Binding TitleActions, Source={RelativeSource TemplatedParent}, Converter={StaticResource IsNotNullConverter}}" />
                    </Grid>
                    <ContentPresenter Grid.Row="1" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>

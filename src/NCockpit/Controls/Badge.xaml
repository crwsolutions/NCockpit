<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:NCockpit.Controls"
             x:Class="NCockpit.Controls.Badge"
             x:Name="This"
             x:DataType="cv:Badge">
    <Border x:Name="Border"
            Background="{Binding BadgeBackground, Source={x:Reference This}}"
            Stroke="{Binding StrokeColor, Source={x:Reference This}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            Padding="10,3">
        <Label Text="{Binding Text, Source={x:Reference This}}"
               FontSize="11"
               TextColor="{Binding TextColor, Source={x:Reference This}}"
               LineBreakMode="TailTruncation" />
    </Border>
</ContentView>

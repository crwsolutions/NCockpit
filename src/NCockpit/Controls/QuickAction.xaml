<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:NCockpit.Controls"
             x:Class="NCockpit.Controls.QuickAction"
             x:Name="This"
             x:DataType="cv:QuickAction">
    <Border x:Name="Border"
            BackgroundColor="Transparent"
            Padding="12,8"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 6">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference This}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference This}}" />
            <PointerGestureRecognizer PointerEntered="OnPointerEntered"
                                      PointerExited="OnPointerExited" />
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="10">
            <Label x:Name="GlyphLabel"
                   FontFamily="FontAwesomeSolid"
                   TextColor="{StaticResource AccentBlue}"
                   VerticalOptions="Center"
                   IsVisible="False" />
            <Image x:Name="ImageIcon"
                   VerticalOptions="Center"
                   IsVisible="False" />
            <Label Text="{Binding Text, Source={x:Reference This}}"
                   FontSize="14"
                   TextColor="{StaticResource Navy}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>

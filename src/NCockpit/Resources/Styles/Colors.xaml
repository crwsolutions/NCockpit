<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand -->
    <Color x:Key="Navy">#1A2744</Color>
    <Color x:Key="Accent">#0D7377</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>

    <!-- Text on light surfaces -->
    <Color x:Key="TextPrimary">#1A2744</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextMuted">#9CA3AF</Color>
    <Color x:Key="HeaderMuted">#B0B8C8</Color>

    <!-- Status -->
    <Color x:Key="Error">#D32F2F</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Warning">#FFD45D</Color>

    <!-- Surfaces and borders -->
    <Color x:Key="Surface">#F5F5F5</Color>
    <Color x:Key="SurfaceAlt">#F0F4F8</Color>
    <Color x:Key="Border">#E5E7EB</Color>

    <!-- SummaryCard icon accents -->
    <Color x:Key="IconBlue">#3B82F6</Color>
    <Color x:Key="IconBlueBg">#E3F2FD</Color>
    <Color x:Key="IconAmber">#F5A623</Color>
    <Color x:Key="IconAmberBg">#FFF3E0</Color>
    <Color x:Key="SuccessGreen">#10B981</Color>

    <!-- Base -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
</ResourceDictionary>

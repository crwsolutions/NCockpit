<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NCockpit.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NCockpit"
    xmlns:pages="clr-namespace:NCockpit.Pages"
    x:Name="shell"
    x:DataType="local:AppShell"
    Title="NCockpit"
    Shell.FlyoutBehavior="Locked"
    NavBarIsVisible="False"
    FlyoutWidth="200"
    FlyoutBackgroundColor="{StaticResource Navy}">

    <!-- Flyout items with FontAwesome6 Free Solid glyphs -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="ShellContent">
            <Grid HeightRequest="52" ColumnDefinitions="Auto,*" Padding="12,8">
                <Label Grid.Column="0"
                       Style="{StaticResource FlyoutIcon}"
                       Text="{Binding Title, Converter={StaticResource TitleToGlyphConverter}}"
                       Margin="0,0,12,0" />
                <Label Grid.Column="1"
                       Style="{StaticResource FlyoutItem}"
                       Text="{Binding Title}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- Overview -->
    <ShellContent
        Title="Overview"
        ContentTemplate="{DataTemplate pages:OverviewPage}"
        Route="overview" />

    <!-- Folders -->
    <ShellContent
        Title="Folders"
        ContentTemplate="{DataTemplate pages:FoldersPage}"
        Route="folders" />

    <!-- Settings -->
    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate pages:SettingsPage}"
        Route="settings" />

    <!-- About -->
    <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate pages:AboutPage}"
        Route="about" />

    <!-- Collapsed/expanded chevron at the bottom of the flyout -->
    <Shell.FlyoutFooter>
        <Grid BackgroundColor="{StaticResource Navy}">
            <Label x:Name="Expander" Text="&#xf191;" FontFamily="FontAwesomeSolid"
                   FontSize="20" Margin="12"
                   TextColor="White"
                   HorizontalOptions="End"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>

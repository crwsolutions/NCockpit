<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:NCockpit.ViewModels.Popups"
               x:Class="NCockpit.Popups.ViewFilePopup"
               x:DataType="vm:ViewFilePopupViewModel"
               Padding="0"
               BackgroundColor="White"
               CanBeDismissedByTappingOutsideOfPopup="True"
               WidthRequest="900"
               HeightRequest="800">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="20,16" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding FileName}"
                   Style="{StaticResource PopupHeader}"
                   FontSize="16"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="&#xf00d;"
                    Style="{StaticResource IconButton}"
                    FontSize="16"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="0"
                    TextColor="{StaticResource HeaderMuted}"
                    Command="{Binding CloseCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <Border Grid.Row="1">
            <Grid>
                <!-- Error message -->
                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

                <!-- File content -->
                <WebView Background="White"
                         IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNullConverter}}">
                    <WebView.Source>
                        <HtmlWebViewSource Html="{Binding Html}" />
                    </WebView.Source>
                </WebView>
            </Grid>
        </Border>
    </Grid>

</toolkit:Popup>

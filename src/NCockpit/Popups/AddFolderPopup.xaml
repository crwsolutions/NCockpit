<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:vm="clr-namespace:NCockpit.ViewModels.Popups"
               x:Class="NCockpit.Popups.AddFolderPopup"
               x:DataType="vm:AddFolderPopupViewModel"
               x:TypeArguments="vm:AddFolderResult"
               Padding="0"
               BackgroundColor="White"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <VerticalStackLayout Spacing="0">
        <!-- Header -->
        <Grid BackgroundColor="#1a2744" Padding="20,16" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Add Project Folder"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="✕"
                    Padding="0"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="0"
                    BackgroundColor="Transparent"
                    TextColor="#b0b8c8"
                    FontSize="18"
                    Command="{Binding CancelCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <VerticalStackLayout Padding="20" Spacing="16" WidthRequest="400">

            <!-- Folder Path Entry -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Folder Path"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#1a2744" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" x:Name="FolderPathEntry"
                       Text="{Binding FolderPath}"
                       Placeholder="C:\Projects or \\server\share"
                       PlaceholderColor="#999999"
                       FontSize="13"
                       TextColor="#1a2744"
                       BackgroundColor="White" />
                    <Button Grid.Column="1"
                            Text="..."
                            WidthRequest="40"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="6"
                            BackgroundColor="#0d7377"
                            TextColor="White"
                            Command="{Binding ChooseFolderCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Folder Type Selection -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Folder Type"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#1a2744" />
                        <Label Text="{Binding IsPrimary, StringFormat='Folder is primary ({0})'}"
                               FontSize="11"
                               TextColor="#666666" />
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsPrimary}"
                            OnColor="#0d7377"
                            VerticalOptions="Center" />
                </Grid>

                <Label Text="Primary folders are scanned for projects. Secondary folders add every first-level subfolder of the chosen path (the path itself is not added) and can be linked to a project from the project details page."
                       FontSize="10"
                       TextColor="#999999"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   FontSize="11"
                   TextColor="#d32f2f"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Footer Buttons -->
        <Grid BackgroundColor="#f5f5f5"
              Padding="20"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Padding="12,10"
                    CornerRadius="6"
                    BackgroundColor="White"
                    TextColor="#666666"
                    FontSize="12"
                    FontAttributes="Bold"
                    BorderColor="#e0e0e0"
                    BorderWidth="1"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="1"
                    Text="Add Folder"
                    Padding="12,10"
                    CornerRadius="6"
                    BackgroundColor="#0d7377"
                    TextColor="White"
                    FontSize="12"
                    FontAttributes="Bold"
                    Command="{Binding AddFolderCommand}" />
        </Grid>
    </VerticalStackLayout>

</toolkit:Popup>

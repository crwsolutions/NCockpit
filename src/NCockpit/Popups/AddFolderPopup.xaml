<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:vm="clr-namespace:NCockpit.ViewModels.Popups"
               x:Class="NCockpit.Popups.AddFolderPopup"
               x:DataType="vm:AddFolderPopupViewModel"
               x:TypeArguments="vm:AddFolderResult"
               Padding="0"
               BackgroundColor="White"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <VerticalStackLayout Spacing="0">
        <!-- Header -->
        <Grid BackgroundColor="{StaticResource Navy}" Padding="20,16" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Add Project Folder"
                   Style="{StaticResource PopupHeader}"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="✕"
                    Style="{StaticResource IconButton}"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="0"
                    TextColor="{StaticResource HeaderMuted}"
                    Command="{Binding CancelCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <VerticalStackLayout Padding="20" Spacing="16" WidthRequest="400">

            <!-- Folder Path Entry -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Folder Path"
                       Style="{StaticResource FieldLabel}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" x:Name="FolderPathEntry"
                       Text="{Binding FolderPath}"
                       Placeholder="C:\Projects or \\server\share"
                       FontSize="13"
                       BackgroundColor="White" />
                    <Button Grid.Column="1"
                            Text="..."
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="40"
                            Padding="0"
                            Command="{Binding ChooseFolderCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Folder Type Selection -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Folder Type"
                               Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding IsPrimary, StringFormat='Folder is primary ({0})'}"
                               Style="{StaticResource HintLabel}" />
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsPrimary}"
                            VerticalOptions="Center" />
                </Grid>

                <Label Text="Primary folders are scanned for projects. Secondary folders add every first-level subfolder of the chosen path (the path itself is not added) and can be linked to a project from the project details page."
                       Style="{StaticResource HintLabel}"
                       FontSize="10"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   FontSize="11"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Footer Buttons -->
        <Grid BackgroundColor="{StaticResource Surface}"
              Padding="20"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="12"
                    Command="{Binding CancelCommand}" />

            <Button Grid.Column="1"
                    Text="Add Folder"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="12"
                    Command="{Binding AddFolderCommand}" />
        </Grid>
    </VerticalStackLayout>

</toolkit:Popup>

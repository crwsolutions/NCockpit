<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:NCockpit.ViewModels.Popups"
               x:Class="NCockpit.Popups.ScanPopup"
               x:DataType="vm:ScanPopupViewModel"
               Padding="0"
               BackgroundColor="White"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <VerticalStackLayout Spacing="0">
        <!-- Header -->
        <Grid BackgroundColor="{StaticResource Navy}" Padding="20,16" ColumnDefinitions="*">
            <Label Grid.Column="0"
                   Text="{Binding Title}"
                   Style="{StaticResource PopupHeader}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Content: activity indicator, status text, and progress bar -->
        <VerticalStackLayout Padding="20" Spacing="12" WidthRequest="360">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center" />

            <Label Text="{Binding StatusText}"
                   Style="{StaticResource DetailValue}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap" />

            <ProgressBar Progress="{Binding Progress}"
                         HeightRequest="6" />
        </VerticalStackLayout>

        <!-- Footer Buttons -->
        <Grid BackgroundColor="{StaticResource Surface}" Padding="20" ColumnDefinitions="*">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Style="{StaticResource DangerButton}"
                    FontSize="12"
                    Command="{Binding CancelCommand}" />
        </Grid>
    </VerticalStackLayout>

</toolkit:Popup>

<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:NCockpit.ViewModels.Popups"
               x:Class="NCockpit.Popups.ScanPopup"
               x:DataType="vm:ScanPopupViewModel"
               Padding="0"
               BackgroundColor="White"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <VerticalStackLayout Spacing="0">
        <!-- Header -->
        <Grid BackgroundColor="#1a2744" Padding="20,16" ColumnDefinitions="*">
            <Label Grid.Column="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Content: activity indicator, status text, and progress bar -->
        <VerticalStackLayout Padding="20" Spacing="12" WidthRequest="360">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="#0d7377"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center" />

            <Label Text="{Binding StatusText}"
                   FontSize="13"
                   TextColor="#1a2744"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap" />

            <ProgressBar Progress="{Binding Progress}"
                         ProgressColor="#0d7377"
                         HeightRequest="6" />
        </VerticalStackLayout>

        <!-- Footer Buttons -->
        <Grid BackgroundColor="#f5f5f5" Padding="20" ColumnDefinitions="*">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Padding="12,10"
                    CornerRadius="6"
                    BackgroundColor="#d32f2f"
                    TextColor="White"
                    FontSize="12"
                    FontAttributes="Bold"
                    Command="{Binding CancelCommand}" />
        </Grid>
    </VerticalStackLayout>

</toolkit:Popup>
